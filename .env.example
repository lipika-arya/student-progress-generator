# Copy this file to .env and fill in your real values.
# .env is git-ignored; never commit your API key.

# Which AI service writes the notes: openai or gemini
AI_PROVIDER=openai

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Free key from https://aistudio.google.com (Get API key)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: space out requests to stay under free-tier limits (0 = no limit)
# AI_REQUESTS_PER_MINUTE=8

DATABASE_PATH=data/db/notes.db
